[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python }}"
dependencies = [
    "attrs>=26.1",
    "click>=8.5",
    "hydra-core>=1.4.0rc1",  # 1.3.x crashes on Python 3.14 (argparse help check).
    "numpy>=2.5",
    "pydantic>=2.14",
    "rootutils>=1.0.7",
    "structlog>=26.1",
{% if use_wandb %}
    "wandb>=0.31",
{% endif %}
]

[project.scripts]
{{ cli }}-run = "{{ package }}.cli.run:main"
{{ cli }}-configs = "{{ package }}.cli.configs:main"

[dependency-groups]
dev = [
    "conventions-hooks",
    "import-linter>=2.15",
    "pre-commit>=4.7",
    "pyright[nodejs]>=1.1.414",
    "pytest>=9.1",
    "ruff>=0.17",
]

[tool.uv.sources]
{% set hooks_src = _copier_answers._src_path | replace("git+", "") %}
{% set hooks_rev = _copier_conf.vcs_ref_hash %}
{% if hooks_rev and hooks_src.startswith(("gh:", "https://", "git@")) %}
# The conventions repo at the template's commit; `copier update` moves the pin.
conventions-hooks = { git = "{{ hooks_src | replace('gh:', 'https://github.com/') }}", rev = "{{ hooks_rev }}" }
{% else %}
# The local conventions checkout this project was generated from.
conventions-hooks = { path = "{{ hooks_src }}" }
{% endif %}

[build-system]
requires = ["uv_build>=0.12,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = ["{{ package }}", "nuikit"]

[tool.ruff]
line-length = 88
src = ["src", "tests"]
extend-exclude = ["CONVENTIONS.md"]  # Vendored guide: fix it upstream, not here.

[tool.ruff.lint]
select = [
    "E", "F", "W", "I", "B", "UP", "SIM", "RET", "PTH", "C4", "C90", "RUF", "TID",
    "FBT", "N", "PERF", "G", "LOG", "BLE", "PL", "D", "NPY", "ERA", "T20",
    "TD004", "TD005", "TD006", "TD007",  # A TODO says what and why (GUIDE DOC-6).
    "D401",  # The google convention drops imperative mood; selecting it restores it.
{% if legacy_python %}
    "FA",
{% endif %}
]
ignore = [
    "PLC0415",  # Lazy imports of heavy or optional dependencies are deliberate.
    "PLR2004",  # Thresholds and shapes read better inline than as constants.
    "PLR0913",  # Config-heavy constructors take many keyword arguments.
    "D102", "D103", "D105", "D106", "D107",  # Document methods only when non-obvious.
]

[tool.ruff.lint.per-file-ignores]
"src/{{ package }}/cli/**" = ["T201"]
"scripts/**" = ["T201"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.isort]
known-first-party = ["{{ package }}"]
section-order = ["future", "standard-library", "third-party", "nuikit", "first-party", "local-folder"]
{% if legacy_python %}
required-imports = ["from __future__ import annotations"]
{% endif %}

[tool.ruff.lint.isort.sections]
nuikit = ["nuikit"]  # Vendored machinery reads apart from the project (GUIDE STY-3).

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"unittest.mock".msg = "use an in-process fake instead (GUIDE: TST)"

[tool.pyright]
include = ["src", "tests", "scripts"]
strict = ["src/nuikit"]
typeCheckingMode = "standard"
venvPath = "."
venv = ".venv"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--import-mode=importlib", "--strict-markers", "-m", "not integration"]
markers = ["integration: end-to-end runs that need external services or data"]

[tool.importlinter]
root_packages = ["{{ package }}", "nuikit"]

[[tool.importlinter.contracts]]
name = "Layers: cli on top, paths at the bottom, every module placed"
type = "layers"
containers = ["{{ package }}"]
layers = ["cli", "config", "paths"]
exhaustive = true

[[tool.importlinter.contracts]]
name = "nuikit never imports the project"
type = "forbidden"
source_modules = ["nuikit"]
forbidden_modules = ["{{ package }}"]
