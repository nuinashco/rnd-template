{% macro toml(text) %}"{{ text | regex_replace('[\\x00-\\x1f\\x7f]', ' ') | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}
[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ toml(description) }}
readme = "README.md"
authors = [{ name = {{ toml(author_name) }}, email = {{ toml(author_email) }} }]
requires-python = ">={{ python }}"
dependencies = [
    "attrs>=26.1",
    "click>=8.5",
    "hydra-core>=1.4.0rc1",  # 1.3.x crashes on Python 3.14 (argparse help check).
    "numpy>=2.5",
{% if use_wandb %}
    "nuikit[wandb]>=0.1.0",
{% else %}
    "nuikit>=0.1.0",
{% endif %}
    "omegaconf>=2.4",
    "pydantic>=2.14",
    "rootutils>=1.0.7",
    "structlog>=26.1",
]

[project.scripts]
{{ cli }}-run = "{{ package }}.cli.run:main"
{{ cli }}-configs = "{{ package }}.cli.configs:main"

[dependency-groups]
dev = [
    "conventions-hooks",
    "import-linter>=2.15",
    "pre-commit>=4.7",
    "pyright[nodejs]>=1.1.414",
    "pytest>=9.1",
    "ruff>=0.17",
]

[tool.uv.sources]
# Release tags that `copier update` moves with the template.
nuikit = {{ nuikit_source }}
conventions-hooks = {{ hooks_source }}

[build-system]
requires = ["uv_build>=0.12,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package }}"

# Opts in to the conventions-hooks checks and the conventions plugin's hooks (TOOL-4).
# `ignore = ["RULE-ID"]` turns a rule off; list it under Deviations in CONTRIBUTING.md.
[tool.conventions]

[tool.ruff]
line-length = 88
src = ["src", "tests"]
extend-exclude = ["*.ipynb"]  # Notebooks are for exploration; nbstripout checks them (RUN-5).

[tool.ruff.lint]
select = [
    "E", "F", "W", "I", "B", "UP", "SIM", "RET", "PTH", "C4", "C90", "RUF", "TID",
    "FBT", "N", "PERF", "G", "LOG", "BLE", "PL", "D", "NPY", "ERA", "T20",
    "TD004", "TD005", "TD006", "TD007",  # A TODO says what and why (DOC-6).
    "ANN",  # Every signature in src/ is annotated (TYP-1).
    "PGH004",  # A `# noqa` names its rule (STY-2).
    "D401",  # The google convention drops imperative mood; selecting it restores it.
{% if legacy_python %}
    "FA",
{% endif %}
]
ignore = [
    "PLC0415",  # Lazy imports of heavy or optional dependencies are deliberate.
    "PLR2004",  # Thresholds and shapes read better inline than as constants.
    "PLR0913",  # Config-heavy constructors take many keyword arguments.
    "ANN401",  # `Any` fits JSON-shaped payloads and lazily imported objects (TYP-8).
    "D102", "D103", "D105", "D106", "D107",  # Document methods only when non-obvious.
]

[tool.ruff.lint.per-file-ignores]
"src/{{ package }}/cli/**" = ["T201"]
"scripts/**" = ["T201", "ANN"]
"tests/**" = ["ANN"]  # Test functions and fixtures may skip annotations (TYP-1).

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.isort]
known-first-party = ["{{ package }}"]
section-order = ["future", "standard-library", "third-party", "nuikit", "first-party", "local-folder"]
{% if legacy_python %}
required-imports = ["from __future__ import annotations"]
{% endif %}

[tool.ruff.lint.isort.sections]
# A choice of this template, not of STY-3: nuikit gets its own import block, so the
# library reads apart from the project's code.
nuikit = ["nuikit"]

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"unittest.mock".msg = "use an in-process fake instead (TST-3)"

[tool.pyright]
include = ["src", "tests", "scripts"]
typeCheckingMode = "standard"
venvPath = "."
venv = ".venv"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--import-mode=importlib", "--strict-markers", "-m", "not integration"]
markers = ["integration: end-to-end runs that need external services or data"]

[tool.importlinter]
root_packages = ["{{ package }}"]

[[tool.importlinter.contracts]]
name = "Layers: cli on top, paths at the bottom, every module placed"
type = "layers"
containers = ["{{ package }}"]
{% if example %}
layers = ["cli", "config", "signals | stats", "paths"]
{% else %}
layers = ["cli", "config", "paths"]
{% endif %}
exhaustive = true
