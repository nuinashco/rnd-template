"""Schemas of the entry configs; `make configs` mirrors them to configs/defaults/."""

{% if legacy_python %}
from __future__ import annotations

{% endif %}
{% if example %}
from collections.abc import Mapping
from typing import Any{{ ", Literal" if use_wandb else "" }}

from pydantic import Field, PositiveInt, SerializeAsAny, field_validator
{% else %}
{% if use_wandb %}
from typing import Literal

{% endif %}
from pydantic import Field
{% endif %}

from nuikit.config import Schema
from nuikit.configgen import ConfigFile
from nuikit.logging import LogFormat, LogLevel
{% if example %}
from nuikit.registry import KindConfig

from {{ package }}.signals.base import SignalConfig, SignalFactory
{% endif %}


class MainConfig(Schema):
    """Entry config of `{{ cli }}-run` (configs/run.yaml)."""

    run_name: str = Field(
        default="${now:%Y-%m-%d_%H-%M-%S}", description="directory under runs/"
    )
    seed: int = 42
    deterministic: bool = Field(
        default=False, description="true: deterministic torch kernels, slower"
    )
    log_level: LogLevel = Field(default="info", description="debug|info|warning|error")
    log_format: LogFormat = Field(
        default="auto",
        description="auto|console|json; auto: console in a terminal, JSON otherwise",
    )
{% if use_wandb %}
    tracker: Literal["wandb"] | None = Field(
        default=None, description="wandb: mirror the run to W&B; null: run dir only"
    )
    wandb_project: str = "{{ project_name }}"
    wandb_entity: str | None = Field(
        default=None, description="null: your default entity"
    )
{% endif %}
{% if example %}
    samples: PositiveInt = 100
    # SerializeAsAny keeps the kind's own fields in the run's config.yaml.
    signal: SerializeAsAny[SignalConfig]

    @field_validator("signal", mode="before")
    @classmethod
    def _signal_by_kind(cls, data: Mapping[str, Any] | KindConfig) -> KindConfig:
        return SignalFactory.validate(data)
{% endif %}


{% if example %}
GENERATED = (ConfigFile("defaults/run.yaml", MainConfig, groups=("signal",)),)
{% else %}
GENERATED = (ConfigFile("defaults/run.yaml", MainConfig),)
{% endif %}
