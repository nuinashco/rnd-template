# Files nobody edits by hand (TOOL-5). check-protected refuses agent edits to them and
# GitHub folds their diffs; the command that owns each one still rewrites it. A family
# kind's mirror, configs/<group>/<kind>.yaml, is marked by its `# Generated by` line.
configs/defaults/** linguist-generated protected=generated
.copier-answers.yml linguist-generated protected=generated
notebooks/reference/** linguist-vendored protected=published
