# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and machine-specific settings (see .env.example)
.env

# CI installs from the lock file, so it stays in git even where a global ignore lists *.lock.
!uv.lock

# Notebooks
.ipynb_checkpoints/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Builds, Hydra's own outputs, run outputs and local data. The leading slash keeps these to
# the top level, so a package named `data` or `runs` under src/ or tests/ stays in git.
/build/
/dist/
/outputs/
/multirun/
/runs/
/data/
{% if use_wandb %}

# Weights & Biases, wherever a run starts
wandb/
{% endif %}
